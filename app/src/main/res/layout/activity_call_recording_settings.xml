<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recording_settings_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/recording_settings_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/recording_settings_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:title="@string/call_recording_setup"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/recording_settings_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/recording_settings_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Shizuku status -->
            <TextView
                android:id="@+id/recording_settings_status_label"
                style="@style/SettingsSectionLabelStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/call_recording_status" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/recording_settings_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="@dimen/tiny_margin"
                android:paddingHorizontal="@dimen/activity_margin"
                android:paddingBottom="@dimen/medium_margin" />

            <RelativeLayout
                android:id="@+id/recording_settings_grant_permission_holder"
                style="@style/SettingsHolderTextViewOneLinerStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/recording_settings_grant_permission_label"
                    style="@style/SettingsTextLabelStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/call_recording_grant_permission" />

            </RelativeLayout>

            <!-- Setup -->
            <TextView
                android:id="@+id/recording_settings_setup_label"
                style="@style/SettingsSectionLabelStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/call_recording_setup" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/recording_settings_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoLink="web"
                android:paddingHorizontal="@dimen/activity_margin"
                android:paddingBottom="@dimen/medium_margin"
                android:text="@string/call_recording_info" />

            <RelativeLayout
                android:id="@+id/recording_settings_agree_holder"
                style="@style/SettingsHolderSwitchStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <org.fossify.commons.views.MyMaterialSwitch
                    android:id="@+id/recording_settings_agree"
                    style="@style/SettingsSwitchStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/call_recording_agree" />

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/recording_settings_input_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <org.fossify.commons.views.MyTextInputLayout
                    android:id="@+id/recording_settings_key_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/call_recording_key_hint"
                    android:paddingHorizontal="@dimen/activity_margin"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/recording_settings_key"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:textSize="@dimen/bigger_text_size" />

                </org.fossify.commons.views.MyTextInputLayout>

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/recording_settings_key_help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:paddingHorizontal="@dimen/activity_margin"
                    android:paddingTop="@dimen/small_margin"
                    android:text="@string/call_recording_key_help"
                    android:textSize="@dimen/smaller_text_size" />

                <RelativeLayout
                    android:id="@+id/recording_settings_save_holder"
                    style="@style/SettingsHolderTextViewOneLinerStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/recording_settings_save_label"
                        style="@style/SettingsTextLabelStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/call_recording_test_and_save" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/recording_settings_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorSize="@dimen/normal_icon_size" />

                </RelativeLayout>
            </LinearLayout>

            <RelativeLayout
                android:id="@+id/recording_settings_disable_holder"
                style="@style/SettingsHolderTextViewOneLinerStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/recording_settings_disable_label"
                    style="@style/SettingsTextLabelStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/call_recording_disable" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/recording_settings_files_holder"
                style="@style/SettingsHolderTextViewOneLinerStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/recording_settings_files_label"
                    style="@style/SettingsTextLabelStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/call_recordings" />

            </RelativeLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
