<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1C1C1E"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title Header -->
        <org.fossify.commons.views.MyTextView
            android:id="@+id/edit_contact_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Contact"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Photo & Wallpaper Selection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Profile Photo -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/edit_contact_photo"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person_vector" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/change_photo_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:text="Contact Photo"
                    android:textColor="@color/color_accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="70dp"
                android:background="#33FFFFFF" />

            <!-- Caller Screen Background Photo -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/edit_caller_bg_photo"
                    android:layout_width="90dp"
                    android:layout_height="56dp"
                    android:scaleType="centerCrop"
                    android:background="#2C2C2E"
                    android:src="@drawable/ic_edit" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/change_caller_bg_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:text="Call Wallpaper"
                    android:textColor="@color/color_accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Name Inputs -->
        <org.fossify.commons.views.MyTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Name"
            android:textColor="@color/color_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <org.fossify.commons.views.MyEditText
            android:id="@+id/edit_first_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="First name"
            android:inputType="textPersonName"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:textSize="15sp" />

        <org.fossify.commons.views.MyEditText
            android:id="@+id/edit_middle_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Middle name"
            android:inputType="textPersonName"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:textSize="15sp" />

        <org.fossify.commons.views.MyEditText
            android:id="@+id/edit_surname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Surname / Last name"
            android:inputType="textPersonName"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:textSize="15sp" />

        <!-- Account Destination Selection -->
        <org.fossify.commons.views.MyTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Save to Account"
            android:textColor="@color/color_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/edit_account_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="#2C2C2E"
            android:padding="8dp" />

        <!-- Phone Numbers Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <org.fossify.commons.views.MyTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Phone Numbers"
                android:textColor="@color/color_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/add_phone_number_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:text="+ Add Number"
                android:textColor="@color/color_accent"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/edit_phone_numbers_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <!-- Additional Fields: Nickname, Email, Address, Notes -->
        <org.fossify.commons.views.MyTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Details"
            android:textColor="@color/color_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <org.fossify.commons.views.MyEditText
            android:id="@+id/edit_nickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Nickname"
            android:inputType="textPersonName"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:textSize="15sp" />

        <org.fossify.commons.views.MyEditText
            android:id="@+id/edit_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Email address"
            android:inputType="textEmailAddress"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:textSize="15sp" />

        <org.fossify.commons.views.MyEditText
            android:id="@+id/edit_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Postal address"
            android:inputType="textPostalAddress"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:textSize="15sp" />

        <org.fossify.commons.views.MyEditText
            android:id="@+id/edit_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Notes"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:textSize="15sp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="end"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/cancel_edit_button"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:textColor="#8E8E93" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/save_contact_button"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:backgroundTint="@color/color_accent"
                android:text="@string/save"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
