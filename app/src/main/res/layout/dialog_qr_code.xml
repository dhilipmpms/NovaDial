<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/qr_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <!-- Top Icon -->
    <FrameLayout
        android:id="@+id/qr_dialog_top_icon_container"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/qr_dialog_icon_bg">

        <ImageView
            android:id="@+id/qr_dialog_top_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_qr_code" />
    </FrameLayout>

    <!-- Dialog Title -->
    <org.fossify.commons.views.MyTextView
        android:id="@+id/qr_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Contact QR"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- QR Code Image Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFFFFF">

        <ImageView
            android:id="@+id/qr_image_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:layout_margin="16dp" />
    </androidx.cardview.widget.CardView>

    <!-- Contact Name -->
    <org.fossify.commons.views.MyTextView
        android:id="@+id/qr_contact_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Amma" />

    <!-- Contact Phone Number -->
    <org.fossify.commons.views.MyTextView
        android:id="@+id/qr_contact_phone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="14sp"
        tools:text="000000" />

    <!-- Close Button Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/qr_close_button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Close"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/qr_dialog_btn_bg"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"/>
    </LinearLayout>

</LinearLayout>
