<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recording_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingVertical="@dimen/small_margin"
    android:paddingStart="@dimen/activity_margin"
    android:paddingEnd="@dimen/small_margin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/recording_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/circle_background"
            android:contentDescription="@string/call_recording_play"
            android:padding="10dp"
            android:src="@drawable/ic_play_vector" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/activity_margin"
            android:layout_weight="1"
            android:orientation="vertical">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/recording_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textDirection="firstStrongLtr"
                android:textSize="@dimen/bigger_text_size"
                tools:text="Jane Doe" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/recording_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:singleLine="true"
                android:textSize="@dimen/normal_text_size"
                tools:text="12 Nov 2026 · 14:05" />
        </LinearLayout>

        <org.fossify.commons.views.MyTextView
            android:id="@+id/recording_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/small_margin"
            android:alpha="0.7"
            android:fontFeatureSettings="tnum"
            android:textSize="@dimen/normal_text_size"
            tools:text="03:21" />

        <ImageView
            android:id="@+id/recording_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/more_info"
            android:padding="12dp"
            android:src="@drawable/ic_three_dots_vector" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/recording_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="@dimen/activity_margin"
        android:visibility="gone"
        tools:visibility="visible">

        <SeekBar
            android:id="@+id/recording_seekbar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:contentDescription="@string/call_recording_seek" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/recording_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textSize="@dimen/smaller_text_size"
            tools:text="00:42 / 03:21" />
    </LinearLayout>
</LinearLayout>
