<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ripple_foreground">#33FFFFFF</color>
    <color name="color_missed_call">@color/md_red_500_dark</color>
    <color name="color_outgoing_call">@color/md_green_600</color>
    <color name="color_incoming_call">@color/md_blue_600</color>
    <color name="nova_card">#F3F5F7</color>
    <color name="nova_action_button">#E7F0FF</color>
    <color name="nova_amoled_black">#000000</color>
    <color name="nova_dark_gray">#121212</color>
    <color name="nova_light_gray">#242424</color>
    <!-- #010101 is visually identical to black but avoids the early-exit guard
         in the library's LineColorPickerDialog (which checks color == color_primary).
         The actual icon color default is overridden separately as pure #000000. -->
    <color name="color_primary">#010101</color>
    <color name="color_primary_dark">#010101</color>
    <!-- Override the library's default_app_icon_color so config stores #000000
         (md_grey_black), which the color picker correctly maps to icon index 18. -->
    <color name="default_app_icon_color">#000000</color>
    <color name="color_background">#000000</color>
    <color name="color_secondary">#FFFFFF</color>
    <color name="color_on_secondary">#000000</color>
    <color name="white">#FFFFFF</color>

    <!-- ── Call Screen tokens ────────────────────────────────────────────── -->
    <!-- Dimming overlay applied to the active-call section when a waiting
         call arrives. 50 % opaque black scrim. -->
    <color name="call_active_dim_scrim">#80000000</color>

    <!-- Badge shown on the call-waiting banner: red/warning tone -->
    <color name="call_incoming_badge_bg">#FFEB3B1A</color>   <!-- amber tint surface -->
    <color name="call_incoming_badge_text">#FFFF6F00</color> <!-- deep amber -->

    <!-- Accept / Reject button tint colours -->
    <color name="call_accept_tint">#FF4CAF50</color>   <!-- Material Green 500 -->
    <color name="call_reject_tint">#FFF44336</color>   <!-- Material Red 500 -->

    <!-- End-call button background -->
    <color name="call_end_bg">#FFFF5252</color>        <!-- Material Red A200 -->
    <color name="call_end_icon">#FFFFFFFF</color>

    <!-- Swap / Merge action button background (used in on_hold_status_holder) -->
    <color name="call_action_swap_bg">#FF1976D2</color>  <!-- Material Blue 700 -->
    <color name="call_action_merge_bg">#FF7B1FA2</color> <!-- Material Purple 700 -->
    <color name="call_action_icon">#FFFFFFFF</color>

    <!-- Call-waiting banner stroke / card -->
    <color name="call_waiting_card_stroke">#33FFFFFF</color>
    <color name="call_waiting_label_color">#FFFFA726</color> <!-- Orange 400 — "Incoming" label -->

    <!-- Material 3 Purple Expressive Tokens -->
    <color name="m3_purple_primary">#6750A4</color>
    <color name="m3_purple_on_primary">#FFFFFF</color>
    <color name="m3_purple_primary_container">#EADDFF</color>
    <color name="m3_purple_on_primary_container">#21005D</color>
    <color name="m3_purple_secondary_container">#E8DEF8</color>
    <color name="m3_purple_on_secondary_container">#1D192B</color>
    <color name="m3_purple_surface_container">#F3EDF7</color>
    <color name="m3_purple_surface_container_high">#ECE6F0</color>
</resources>


